;TISK CISLA BC-POZICE HL-HODNOT
;TISKNE CISLO TYPU INTEGER
;STAR-RUTINA TISKU 1 ZNAKU NA
;POZICI BC (0,0)
NUMBER4	ld	de,-10000
	call	NUM_JED
NUMBER3	ld	de,-1000
	call	NUM_JED
NUMBER2	ld	de,-100
	call	NUM_JED
NUMBER1	ld	de,-10
	call	NUM_JED
NUMBER0	ld	a,l
	add	a,48
	push	bc		;new
	call	T42
	pop	bc
	ret

NUM_JED	xor	a
NUM_JED1
	add	hl,de
	jr	nc,NUM_PRIC
	inc	a
	jr	NUM_JED1
NUM_PRIC
	sbc	hl,de
	add	a,48
	push	bc
	push	hl
	call	T42
	pop	hl
	pop	bc
	inc	c
	ret
;/*
;T42_TEXT ld	a,(hl)
;	and	127
;	push	hl
;	push	bc
;	call	T42
;	pop	bc
;	pop	hl
;	inc	c
;	ld	a,(hl)
;	rla
;	inc	hl
;	jr	nc,T42_TEXT
;	ret
