	ld	hl,TEXT_FAT32	;test typu oddilu, bud FAT16/32/other
;	ld	bc,#0c12
	cp	#B		;pro typ oddilu FAT32
	jr	z,part_text
	cp	#C
	jr	z,part_text

	ld	hl,fat_type
	res	0,(hl)
;	res	0,(ix-1)	;nastav priznak FAT16
	ld	hl,TEXT_FAT16
	ld	b,1		;bit 1=1, bit 3=0= FAT16
	cp	6		;pro typ oddilu FAT16
	jr	z,part_text
	cp	4
	jr	z,part_text
	cp	#E
	jr	z,part_text	

	ld	hl,TEXT_OTHER
	ld	b,0		;jde o partisnu jineho type nez FAT16/FAT32

part_text
	push	hl
	ld	a,b
	ld	hl,(VDT_pointer+1)
	ld	(hl),a
	pop	hl
	pop	bc
	call	T42_TEXT

					;ted hledame boot sektor pro dany oddil
		ld	hl,(BUFFER2-2)
		ld	de,#AA55		;znacka platneho zaznamu MBR
		or	a
		sbc	hl,de
		jr	z,load_boot	;Z=tabulka MBR je platna

;disk nema MBR tabulku, pojdme zjistit, zda je v sekotru 0 boot sektor pro FAT16/FAT32
;proverime, zda jde o superfloppy. Ale musi byt FAT16/32, jiank je neplatna.
; IX = začátek sektoru LBA 0
; Boot sektor začíná skokem EB nebo E9
        ld      a,(ix+0)
        cp      #EB
        jr      z,check_bps
        cp      #E9
        jr      nz,not_boot

check_bps:
; BytesPerSector musí být 512 = #0200
; little endian: 00 02
        ld      a,(ix+11)
        or      a
        jr      nz,not_boot

        ld      a,(ix+12)
        cp      #02
        jr      nz,not_boot

; ReservedSectorCount nesmí být 0
        ld      a,(ix+14)
        or      (ix+15)
        jr      z,not_boot

; NumFATs nesmí být 0
        ld      a,(ix+16)
        or      a
        jr      z,not_boot

	inc	hx
	inc	hx
        ld      a,(ix-2)
        cp      #55
        jr      nz,not_boot

        ld      a,(ix-1)
        cp      #AA
        jr      nz,not_boot

;jde o platny boot sektor pro FAT, ted zjistit, zda jde o FAT16/FAT32
;-------------------------------
; Je to FAT32?
;-------------------------------

	ld	hl,(VDT_pointer+1)
        ld      a,(ix+17)        ; RootEntCnt
        or      (ix+18)
        jr      nz,boot_f16

        ld      a,(ix+22)        ; FATSz16
        or      (ix+23)
        jr      nz,boot_f16

        ; obě hodnoty jsou 0
        ; -> struktura BPB odpovídá FAT32

        ld      a,(ix+36)
        or      (ix+37)
        or      (ix+38)
        or      (ix+39)
        jr      z,not_boot
        ; FAT32


boot_f32	ld	a,0+0+4+8	
boot_f16	ld	a,0+0+4+0
		ld	(hl),a		;nastav bity
;tiskni, ze jde o Superfloppy
		ld	hl,TEXT_SFL
		call	T42_TEXT
	jr	load_boot		;a pokracuj

not_boot	pop	bc		;nejde ani o boot sektor, medium nema smysluplna data, konec
		pop	ix
		pop	af

		ld	hl,(VDT_pointer+1)
		ld	(hl),0		;info bajt=0

		ld	hl,TEXT_NODATA
		call	T42_TEXT
		di
		halt			;zatim
;vytisknout, ze medium nema smylsuplna data a konec

; pravděpodobně FAT Boot Sector
/*stary test davame pryc
		ld	hl,0		;jeste puvodni test MBR (puvodni EasyHdd)
		ld	d,h
		ld	e,h
		ld	a,(ix+0)	;je oddil bootovaci? Pokud ano, vycti boot sektor,pokud ne, bude boot v sektoru 0
		and	127
		jr	nz,MBRno
		ld	a,(ix+2)	;ale toto moc nechapu, pro se testuje CHS?
		and	a
		jr	z,MBRno
*/



load_boot	ld	l,(ix+8)
		ld	h,(ix+9)	;nizsi
		ld	e,(ix+10)
		ld	d,(ix+11)	;vyssi


MBRno		ld	(bootsec1+1),de	;pro MBRno, vyplnujeme vse 0
		ld	(bootsec+1),hl	;schovame cislo bootsektoru pro budouci vypocet


;mame boot sektor, jdeme ho nahrat a taky vypsat na obrazovku
		ld	(zzbin),hl
		ld	(zzbin+2),de
		push	hl
		push	de
;		push	bc		;BC=tiskova pozice
		call	HL2ASCII32
;		pop	bc
		inc	c		;posunuli jsme tiskovou pozici

		ld	hl,zzdec+9
		set	7,(hl)
		ld	hl,zzdec
;		ld	bc,#0B10

mbs1		ld	a,(hl)
		or	a
		jr	nz,mbs2
		inc	hl
		inc	c
		jr	mbs1

mbs2		call	T42_TEXT	;vypis jeho cislo

		pop	hl
		pop	de		;HLDE=boot sektor

		inc	c
		push	bc		;posun tiskovou pozici

		ld	ix,BUFFER
		call	SD_READ		;nacti boot na adresu v IX (BUFFER)

/*toto bylo na zacatku, kdyz jsem si to potreboval vizualizovat
		ld	hl,BUFFER+11	;prenes hodnoty z boot sektoru potrebne pro vypocet
		ld	de,BPB_BytesPerSec	
		ld	bc,8
		ldir
		ld	hl,BUFFER+22
		ld	(BPB_FATSz16),hl
		ld	hl,BUFFER+36
		ld	bc,4
		push	bc
		ldir
		ld	hl,BUFFER+44
		pop	bc
		ldir

;hodnoty z bootu
BPB_BytesPerSec		dw	#5555	;offset	11	delka 2
BPB_SecPerClus		db	#55	;offset	13	delka 1
BPB_RsvdSecCnt		dw	#5555	;offset	14	delka 2
BPB_NumFATs		db	#55	;offset 16	delka 1

FAT16:
BPB_RootEntCnt		dw	#5555	;offset	17	delka 2
BPB_FATSz16		dw	#5555	;offset	22	delka 2

FAT32:
BPB_FATSz32		dw	#5555,#5555	;offset	36	delka 4
BPB_RootClus		dw	#5555,#5555	;offset	44	delka 4
*/


;3. Výpočet prvního datového sektoru
;pocet FAT x velikost FAT
		ld	l,(ix+17)	;pouze pro FAT16. pocet polozek v Root diru, rovnou vypocitame pocet polozek
		ld	h,(ix+18)	;(pocet polozek*32)/512=pocet sektoru
		
		ld	b,4		;vpocet si zjednodusime
lb2_f16		srl	h
		rr	l
		djnz	lb2_f16
		ld	(RootEntCnt+1),hl	;

		ld	a,(ix+13)	;pocet sektoru na cluster
		ld	(l1F+1),a

		bit	0,(ix-1)	;jdeme pocitat, nejprve počet FATx delka FAT
		ld	l,(ix+22)	;FAT16-pocet sektoru FAT
		ld	h,(ix+23)
		ld	de,0
		jr	z,lb1_f16		
		ld	l,(ix+36)	;FAT32- pocet sektoru FAT
		ld	h,(ix+37)
		ld	e,(ix+38)
		ld	d,(ix+39)
lb1_f16		ld	a,(ix+16)	;pocet FAT tabulek
		call	MUL32x8		;nasobeni 32x8, vysledek je HL'DE'

;pricteme k tomu pocet rezervovanych sektoru
		ld	c,(ix+14)	;pocet rezervovanych sektoru
		ld	b,(ix+15)
		call	ADD32_16	;scitani 32+16, out HLDE
		exx			;vysledek je v HLDE
;mame FirstDataSectorRel
					;jeste pricist sektory od bootu
;pricteme k tomu PartitionStartLBA (boot sektor)
bootsec		ld	hl,#5555	;nizsi
bootsec1	ld	de,#5555	;vyssi
		call	ADD32_32	;vysledek je v HLDE
;hotovo pro FAT16. HLDE= root dir pro FAT16


		bit	0,(ix-1)
		jr	z,load_root_dir

		exx
					;pro FAT32 musime pokracovat
		ld	l,(ix+44)	;first cluster number of the root directory
		ld	h,(ix+45)
		ld	e,(ix+46)
		ld	d,(ix+47)
;odecteme 2, protoze pokud je cluster ve FAT32=2, pak zacatek root dir je hned za FAT2, jako u FAT16
		ld	a,2
		call	SUB32_8		
		ld	a,(ix+13)
		call	MUL32x8
		call	ADD32_32
					;HLDE=root dir pro FAT32

load_root_dir	pop	bc		;tiskova pozice, nechame ji venku, nic ji neposkozuje
		push	hl
		push	de		;dame to bokem

		ld	(zzbin),hl	;nejprve tisk
		ld	(zzbin+2),de

		call	HL2ASCII32
		ld	hl,zzdec+9
		set	7,(hl)
		ld	hl,zzdec
;		ld	bc,#0B1B
;		pop	bc
lrd1		ld	a,(hl)
		or	a
		jr	nz,lrd2
		inc	hl
		inc	c
		jr	lrd1

lrd2		call	T42_TEXT	;vypis jeho cislo
					;... a load a vyhledani souboru .MBD/.MBH
		inc	c

		pop	hl
		pop	de		;HLDE=Root Dir FAT32/FAT16
;uschovame ho, bude ještě potřeba, je to start DIRs sektoru pro FAT16, nebo start datovch sektoru pro FAT32
		push	hl		
		push	de

		push	bc		;tiskova pozice

;	ld	ix,BUFFER
;;;	ld	a,%00000000	;master
	call	SD_READ

	ld	b,8		;;prohledam prvnich 8 polozek, jestli zde neni mbd nebo mbh soubor, hledam jen priponu
	ld	de,32		;; kazda polozka ma 32 bytes
	ld	hl,(VDT_pointer)
nextfile
	ld	a,(ix+08h)
	cp	"M"
	jr	nz, neplatne
	ld	a,(ix+09h)
	cp	"B"
	jr	nz, neplatne
	ld	a,(ix+0ah)
	cp	"H"
	jr	z, platne
	cp	"D"
	jr	z, platne
neplatne
	add	ix,de
	djnz	nextfile

	res	1,(hl)		;nastav priznak, ze jde o nepouzitelny oddil, nema MBD soubor

	ld	hl,TEXT_NODATA
	pop	bc		;tiskova pozice
	call	T42_TEXT	;tisk "No Data"= soubor MBD/MBH neni pritomen
;	ld	e,2		;;pokud nenajdu pouziji cluster 0
	ld	hl,0
	ld	d,h
	ld	e,h		
	jr	l1F


;Skutečná fyzická pozice souboru na disku se spočítá tak, že se od čísla clusteru odečte 2, to se vynásobí počtem sektorů na cluster a přičte se začátek datové oblasti. Stejne pro FAT16 i FAT32.

platne	set	1,(hl)
	pop	bc		;tiskova pozice
	push	ix
	pop	hl
	set	7,(ix+10)
	call	T42_TEXT	;vypis jeho nazev
	push	bc		;tiskova pozice
	ld	l,(ix+26)	;;cluster na kterem zacina soubor
	ld	h,(ix+27)
	ld	e,(ix+20)
	ld	d,(ix+21)	;hlde=cluster of a file
	ld	a,2		;nutno odecist 2
	call	SUB32_8

l1F	ld	a,#55		;pocet sektoru na cluster
	call	MUL32x8		;vysledek v HLDE
	exx
	pop	bc		;tiskova pozice
	pop	hl
	pop	de		;HLDE=Root Dir FAT32/FAT16
	push	bc		;tiskova pozice
	call	ADD32_32

				;HLDE´prvni sektor image MBD/MBH pro FAT16:)
;pricitame RootDirsSectors (neboli RootEntCnt)- oznacuje pocet polozek v RootDirs sektoru
;nasobime *32
;pouze u FAT16

		bit	0,(ix+0)
		jr	nz,end_partition

		exx

RootEntCnt	ld	hl,#5555
		call	ADD32_32

				;v HLDE je prvni sektor image MBD/MBH, i pro FAT32:)

/*
osetrit:
- DONE neni MBR- pak bude svitit jen jeden radek ve vyisu, a bude snaha datekovat FAT16/FAT32/other
- DONE partisna neni FAT16/FAT32- nech sviti napis "oth" a skoci se na detekci dalsi partisny
- DONE partisna je FAT16/FAT32, ale soubor se nenasel- pak necht sviti cervene No File.
- nyni se automaticky vezme prvni partisna, do VDT, ale chceme tam dat user defined, tzn, pridat kurzor!!!

Nasledne tyto 3 stavy se musi vepsat do VDT tabulky


nova specifikace VDT:
- disk muze mit max 4 primarni partisny. Udaje o nich jsou v MBR v nultem sektoru disku.
- budou dve VDT tabulky pro master a slave= 5x32= 256 bajtu= celkova delka VDT tabulky

- struktura 1 zaznamu (z osmi) ve VDT tabulce:
;offset	pocet	popis
**********************
;0	1	info bajt
;1	4	first LBA sector of first MBD/MBH file on disk
;2	1	reserved
;3	26	user defined text


info bajt o oddilu rika:
;bit 0		0= oddil FAT16/32 jakozto MBR neexistuje
		1= oddil FAT16/32 jakozto MBR existuje
;bit 1		1= pouzitelny oddil pro speccy (tj. obsahuje jako prvni MBD soubor, lze ho pouzit)
		0= nepouzitelny oddil pro speccy (tj. neobsahuje MBD soubor)
;bit 2		0= pokud je bit 1 nulovy, pak 0=zadna smysluplna data nejsou na disku pritomna, 1=jde o disk FAT16/FAT32 bez MBR (bit 3 je pak platny). Pokud je bit 1 nenulovy, pak 0= oddil se nepouziva, 1= oddil se pouziva*
;bit 3		0= FAT16, 1=FAT32 (volitelne)
;bity 4-7	rezervovane
;*v BSDOSu muze soucasne fungovat jen jeden oddil

*/

end_partition
;		cp	4
;		jr	nz,ep2			;NZ= nejdo o prvni partisnu

;zatim budou data ve vsech partisnach
;pokud je General setting nastavena autoconfigurace, tak ulozi vypocteny prvni datovy sector
;		ld	c,a
		ld	a,(@autoconfig)
		or	a
;		ld	a,c
;		jr	z,nemenfirstdatasectorm1
		jr	z,ep2

		ld	b,h
		ld	c,l		;dame HL do BC, abychomm mohli vyplnovat VDT tabulku

VDT_pointer	ld	hl,#5555
		inc	hl
		ld	(hl),c
		inc	hl
		ld	(hl),b
		inc	hl
		ld	(hl),e
		inc	hl
		ld	(hl),d
		ld	bc,28
ep3		add	hl,bc
		ld	(VDT_pointer+1),hl	;datove sektory jsou vepsany do tabulky, tabulka je pripravena na dalsi zapis

;		ld	de,VDT+5
;		ex	de,hl
;		ld	(hl),e
;		inc	hl
;		ld	(hl),d

ep2		pop	bc
		pop	ix
		pop	af

		inc	b			;zvys poradovy radek
		ld	de,16
		add	ix,de			;move pointer to another partition
		dec	a
ep1		jp	nz,test_partitions		;moc daleko, musim vymyslet jinak

		jr	nemenfirstdatasectorm1

no_partition	ld	b,#C			;nulovy zaznam v MBR
		ld	c,1
		ld	hl,TEXT_PART_EMPTY
		call	T42_TEXT
		xor	a
		ld	hl,(VDT_pointer+1)
		ld	(hl),a		;nastav bity ve VDT k teto partisne na 0
		ld	bc,31
		jr	ep3

;stary kod-testuje jen prvni partisnu
nemenfirstdatasectorm1
/*
;nacteni MBR
	ld	ix,BUFFER
;;;	ld	a,%00000000	;master
	ld	bc,0
	ld	de,0		;HLDE=HL=high, DE=low; was BCDE
;;;	ld	hl,0		;LBA=0 MBR
	call	LBAREAD
; dodelat osetreni erroru
	inc	hx
	inc	hx		;+512

	ld	a,(ix-64+2)	;text typu 1. oddilu (FAT16/FAT32/jiny)
	ld	hl,TEXT_FAT32
	ld	bc,#0c12
	ld	e,0
	cp	#B		;pro typ oddilu FAT32
	jr	z,part_text
	cp	#C
	jr	z,part_text

	inc	e
	ld	hl,TEXT_FAT16
	cp	6		;pro typ oddilu FAT16
	jr	z,part_text
	cp	4
	jr	z,part_text
	cp	#E
	jr	z,part_text	

	ld	hl,TEXT_OTHER

part_text
	ld	a,e
	ld	(part_type+1),a
	call	T42_TEXT

;; novy kod je-li vubec MBR pritomen
	ld	de,0		;;FAT boot sector zacina na LBA0, pokud neni MBR
	ld	a,(ix-66)	;;1BE
	and	127		;;80h or 00h MRB first partion table does exist
	jr	nz, MBRno
	ld	a,(ix-64)	;;1C0
	and	a		;;pokud existuje patition, tak sector je nenulova
	jr	z, MBRno
MBRyes 
;; end of novy kod je-li vubec MBR pritomen
	ld	e,(ix-58)	;info o prvni partition zacina na #1BE
	ld	d,(ix-57)
MBRno	ex	de,hl		;v hl je cislo sectoru kde zacina boot prvni par.
	ld	(bootsec+1),hl	;schovame cislo bootsectoru pro vypocet
	ld	bc,#0B10
	push	hl
	call	NUMBER3
;nacteni BOOT sectoru prvni partition
	pop	hl
	ld	c,l
	ld	e,h
	ld	d,0
	ld	b,d
	ld	ix,BUFFER
;;;	ld	a,%00000000 ;master
	call	LBAREAD
; dodelat osetreni erroru
; vypocet datove oblasti prvniho souboru

	ld	hl,TEXTDATASEC
	ld	bc,#0B15
	call	T42_TEXT

bootsec	ld	hl,0
	ld	e,(ix+14)	;pricteme sectory pred FAT
	ld	d,(ix+15)
	add	hl,de
	push	hl
	push	ix
	ld	e,(ix+16)	;pocet FAT
	ld	d,0
part_type
	ld	a,#55		;either 0 (FAT32) or 1 (FAT16)
	or	a
	jr	z,part_32
	ld	l,(ix+22)	;pocet sektoru FATky ve FAT 16
	ld	h,(ix+23)
	jr	part_c
part_32	ld	l,(ix+36)	;pocet sekotru FATky ve FAT 32	
	ld	h,(ix+37)
part_c	call	nasobeniHLDE.nasob	;vysledek v IXHL
	pop	ix
	pop	de
	add	hl,de		;pricteme jen spodnich 16 bitu
	;; v HL je LBA Root Directory sectoru
	ld	e,(ix+17)	;pocet polozek v ROOTu
	ld	d,(ix+18)
;; novy kod pro vypocet prvniho datoveho sektoru s ohleden na souboru v rootu
	ld	c,(ix+0dh)	;;pocet sectoru v clusteru, obvykle 64 (32KB cluster)
	ld	b,0
	push	de
	push	hl
	push	bc
	;;nacteni Root Directory sectoru
	ld	c,l
	ld	e,h
	ld	d,0
	ld	b,d
	ld	ix,BUFFER
;;;	ld	a,%00000000	;master
	call	LBAREAD

	ld	b,8		;;prohledam prvnich 8 polozek, jestli zde neni mbd nebo mbh soubor, hledam jen priponu
	ld	de,32		;; kazda polozka ma 32 bytes
nextfile
	ld	a,(ix+08h)
	cp	"M"
	jr	nz, neplatne
	ld	a,(ix+09h)
	cp	"B"
	jr	nz, neplatne
	ld	a,(ix+0ah)
	cp	"H"
	jr	z, platne
	cp	"D"
	jr	z, platne
neplatne
	add	ix,de
	djnz	nextfile
	ld	e,2		;;pokud nenajdu pouziji cluster 0
	jr	l1F


platne	ld	e,(ix+1ah)	;;cluster na kterem zacina soubor
l1F	ld	d,0
	dec	de		;;The clusters are numbered starting at 2, not 0! So the above calculation has to have 2 added to it to get the cluster number of a given allocation unit...and a cluster number is converted to an allocation unit number by subtracting 2...!
	dec	de
	pop	hl		;;pocet sectoru v clusteru, obvykle 64 (32KB cluster)
	call	nasobeniHLDE.nasob	;; vysledek v IXHL
	ex	de,hl
	pop	hl		;; v HL je LBA Root Directory sectoru
	add	hl,de
	pop	de
;; konec kodu pro vypocet prvniho datoveho sektoru s ohleden na souboru v rootu 
	; vydelime 16; predpokladame velikost sec. 512 a 32bytu v root polozce
	ld	b,4
ctyrikrat1 
	srl	d
	rr	e
	djnz	ctyrikrat1
	add	hl,de
	push	hl
	ld	bc,#0B23
	call	NUMBER4
	pop	hl
;pokud je General setting nastavena autoconfigurace, tak ulozi vypocteny prvni datovy sector

	ld	a,(@autoconfig)
	or	a
	jr	z,nemenfirstdatasectorm1
	ld	de,VDT+5
	ex	de,hl
	ld	(hl),e
	inc	hl
	ld	(hl),d

