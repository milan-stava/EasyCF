  92  8009              ;------------------------------------------------------------
  93  8009              ; eLeMeNt ZX + external MB03+: route ZXi accesses to the external
  94  8009              ; MB03+ and switch that interface to MB02+/BSDOS mode.
  95  8009              ;
  96  8009              ; First verify that this really is an eLeMeNt family machine.
  97  8009              ; e_zxi_0FF: upper nibble #E identifies the eLeMeNt family.
  98  8009              ; Lower nibble may change on future eLeMeNt revisions.
  99  8009              ;
 100  8009              ; g_zxi_000 = #00  -> external device (MB03+)
 101  8009              ; m_zxi_000 = #01  -> MB02+ / BSDOS mode
 102  8009              ;
 103  8009              ; m_zxi_002 = #03 -> Hood/EasyCF IDE mapping, verified on real MB03+ hardware.
 104  8009              EL_MB02_INIT
 105  8009 F5           		push	af
 106  800A C5           		push	bc
 107  800B
 108  800B 01 3B 78     		ld	bc,#783B
 109  800E 3E FF        		ld	a,#FF
 110  8010 ED 79        		out	(c),a
 111  8012 01 3B 79     		ld	bc,#793B
 112  8015 ED 78        		in	a,(c)
 113  8017 E6 F0        		and	#F0
 114  8019 FE E0        		cp	#E0
 115  801B 20 26        		jr	nz,.done
 116  801D
 117  801D              		; Select external MB03+ in the general ZXi device selector.
 118  801D 01 3B 7C     		ld	bc,#7C3B
 119  8020 AF           		xor	a
 120  8021 ED 79        		out	(c),a
 121  8023 01 3B 7D     		ld	bc,#7D3B
 122  8026 ED 79        		out	(c),a
 123  8028
 124  8028              		; Switch the external MB03+ to MB02+/BSDOS mode.
 125  8028 01 3B 70     		ld	bc,#703B
 126  802B AF           		xor	a
 127  802C ED 79        		out	(c),a
 128  802E 01 3B 71     		ld	bc,#713B
 129  8031 3E 01        		ld	a,#01
 130  8033 ED 79        		out	(c),a
 131  8035
 132  8035              		; Enable the Hood/EasyCF IDE mapping required by the ATA routines.
 133  8035              		; Value #03 was verified on real MB03+ hardware with working BSDOS+CF.
 134  8035 01 3B 70     		ld	bc,#703B
 135  8038 3E 02        		ld	a,#02
 136  803A ED 79        		out	(c),a
 137  803C 01 3B 71     		ld	bc,#713B
 138  803F 3E 03        		ld	a,#03
 139  8041 ED 79        		out	(c),a
 140  8043
 141  8043 C1           .done		pop	bc
 142  8044 F1           		pop	af
 143  8045 C9           		ret
