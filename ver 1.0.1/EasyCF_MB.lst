 800+ 97BF
 801+ 97BF ~            /*
 802+ 97BF ~            1. Výpočet pro FAT16
 803+ 97BF ~            ********************
 804+ 97BF ~            Kořenový adresář u FAT16 má pevnou velikost a leží hned za poslední FAT tabulkou.
 805+ 97BF ~
 806+ 97BF ~            Vzorec (číslo sektoru od začátku disku/partice):
 807+ 97BF ~
 808+ 97BF ~            RootSector{FAT16}=ReservedSecCnt+(NumFATs x FATSize16)
 809+ 97BF ~
 810+ 97BF ~            Velikost root adresáře (v sektorech) se spočítá jako (RootEntCnt × 32 + BytsPerSec - 1) / BytsPerSec, ale jeho začátek je dán čistě součtem rezervovaných sektorů a obou FAT tabulek.
 811+ 97BF ~
 812+ 97BF ~            2. Výpočet pro FAT32
 813+ 97BF ~            Kořenový adresář u FAT32 nemá pevnou pozici, je to běžný cluster. Nejprve musíme spočítat začátek datové oblasti (DataSecStart) a k němu přičíst offset daný počátečním clusterem (RootClus).
 814+ 97BF ~
 815+ 97BF ~            Vzorec pro začátek datové oblasti (stejný jako FAT16):
 816+ 97BF ~
 817+ 97BF ~            DataSecStart=ReservedSecCnt+(NumFATs x FATSize32)
 818+ 97BF ~
 819+ 97BF ~            Vzorec pro počáteční sektor root adresáře (rootClus):
 820+ 97BF ~
 821+ 97BF ~            RootSector{FAT32}= DataSecStart+((RootClus-2) x SecPerClus)
 822+ 97BF ~
 823+ 97BF ~            (Odečítá se 2, protože clustery 0 a 1 v datové oblasti fyzicky neexistují – číslování datových clusterů začíná od 2).
 824+ 97BF ~
 825+ 97BF ~
 826+ 97BF ~
 827+ 97BF ~            Kde najít rootClus a SecPerClus (pro FAT32)
 828+ 97BF ~            *******************************************
 829+ 97BF ~            Obě hodnoty jsou uloženy v boot sektoru (v datové struktuře BPB – BIOS Parameter Block):
 830+ 97BF ~
 831+ 97BF ~            - SecPerClus (Sectors per Cluster): 1bajtová hodnota na offsetu 0x0D (decimálně 13) od začátku boot sektoru
 832+ 97BF ~
 833+ 97BF ~            - rootClus (Root Directory Start Cluster): 4bajtová hodnota na offsetu 0x2C (decimálně 44) od začátku boot sektoru (obvykle 2)
 834+ 97BF ~
 835+ 97BF ~            Výpočet počátečního sektoru Root Dir
 836+ 97BF ~            ************************************
 837+ 97BF ~            Pro výpočty používáme tyto proměnné z boot sektoru:
 838+ 97BF ~            - ReservedSecCnt = Počet rezervovaných sektorů (offset 0x0E (dec 14), 2 bajty)
 839+ 97BF ~            - NumFATs = Počet FAT tabulek (offset 0x10 (dec 16), 1 bajt, obvykle 2)
 840+ 97BF ~            - FATSize16 = Počet sektorů jedné FAT u FAT16 (offset 0x16 (dec 22), 2 bajty)
 841+ 97BF ~            - FATSize32 = Počet sektorů jedné FAT u FAT32 (offset 0x24 (dec 36), 4 bajty)
 842+ 97BF ~            - RootEntCnt = Maximální počet položek v root adresáři u FAT16 (offset 0x11 (dec 17), 2 bajty, obvykle 512)
 843+ 97BF ~            - BytsPerSec = Počet bajtů na sektor (offset 0x0B (dec 11), 2 bajty, obvykle 512)
 844+ 97BF ~            - SecPerClus = Počet sektorů na cluster (offset 0x0D (dec 13), 1 bajt)
 845+ 97BF ~            - RootClus = Počáteční cluster root adresáře u FAT32 (offset 0x2C (dec 44), 4 bajty)
 846+ 97BF ~
 847+ 97BF ~            */
 848+ 97BF
 849+ 97BF ~            /*
 850+ 97BF ~            1. k boot sektoru se umime dostat z MBR
 851+ 97BF ~            2. potřebné pro výpočet z boot sektoru, tyto hodnoty jsou relativni k zacatku partisny:
 852+ 97BF ~            ---------------------------------------------------------------------------------------
 853+ 97BF ~            BPB_BytesPerSec		offset	11	delka 2
 854+ 97BF ~            BPB_SecPerClus		offset	13	delka 1
 855+ 97BF ~            BPB_RsvdSecCnt		offset	14	delka 2
 856+ 97BF ~            BPB_NumFATs		offset  16	delka 1
 857+ 97BF ~
 858+ 97BF ~            FAT16:
 859+ 97BF ~                BPB_RootEntCnt	offset	17	delka 2
 860+ 97BF ~                BPB_FATSz16		offset	22	delka 2
 861+ 97BF ~
 862+ 97BF ~            FAT32:
 863+ 97BF ~                BPB_FATSz32		offset	36	delka 4
 864+ 97BF ~                BPB_RootClus	offset	44	delka 4
 865+ 97BF ~
 866+ 97BF ~
 867+ 97BF ~            3. vypocet prvniho datoveho sektoru
 868+ 97BF ~            --------------------------------
 869+ 97BF ~            FAT16
 870+ 97BF ~            Spočti velikost Root Directory:
 871+ 97BF ~
 872+ 97BF ~            RootDirSectors =
 873+ 97BF ~            (RootEntCnt × 32) / BytesPerSector
 874+ 97BF ~
 875+ 97BF ~            Potom:
 876+ 97BF ~            FirstDataSectorRel =
 877+ 97BF ~            RsvdSecCnt +
 878+ 97BF ~            NumFATs × FATSz16 +
 879+ 97BF ~            RootDirSectors
 880+ 97BF ~
 881+ 97BF ~            Absolutni LBA:
 882+ 97BF ~            FirstDataSectorAbs =
 883+ 97BF ~            PartitionStartLBA +
 884+ 97BF ~            FirstDataSectorRel
 885+ 97BF ~
 886+ 97BF ~
 887+ 97BF ~            FAT32
 888+ 97BF ~            Root Directory je součást datové oblasti.
 889+ 97BF ~
 890+ 97BF ~            Proto:
 891+ 97BF ~            FirstDataSectorRel =
 892+ 97BF ~            RsvdSecCnt +
 893+ 97BF ~            NumFATs × FATSz32
 894+ 97BF ~
 895+ 97BF ~            Absolutně:
 896+ 97BF ~            FirstDataSectorAbs =
 897+ 97BF ~            PartitionStartLBA +
 898+ 97BF ~            FirstDataSectorRel
 899+ 97BF ~
 900+ 97BF ~
 901+ 97BF ~            4. Načti Root Directory
 902+ 97BF ~            -----------------------
 903+ 97BF ~            FAT16
 904+ 97BF ~
 905+ 97BF ~            Root Directory začíná na:
 906+ 97BF ~            RootDirLBA =
 907+ 97BF ~            PartitionStartLBA +
 908+ 97BF ~            RsvdSecCnt +
 909+ 97BF ~            NumFATs × FATSz16
 910+ 97BF ~
 911+ 97BF ~            Je pevně daný.
 912+ 97BF ~
 913+ 97BF ~            FAT32
 914+ 97BF ~
 915+ 97BF ~            Root Directory začíná v clusteru:
 916+ 97BF ~            RootCluster = BPB_RootClus
 917+ 97BF ~
 918+ 97BF ~            (obvykle 2)
 919+ 97BF ~
 920+ 97BF ~            První sektor Root Directory:
 921+ 97BF ~            RootDirLBA =
 922+ 97BF ~            FirstDataSectorAbs +
 923+ 97BF ~            (RootCluster − 2) × SecPerClus
 924+ 97BF ~
 925+ 97BF ~
 926+ 97BF ~
 927+ 97BF ~            5. Najdi soubor MBD / MBH
 928+ 97BF ~            -------------------------
 929+ 97BF ~            Projdi prvních 8 položek.
 930+ 97BF ~
 931+ 97BF ~            Přečti:
 932+ 97BF ~
 933+ 97BF ~            FAT16:
 934+ 97BF ~            DIR_FstClusLO
 935+ 97BF ~
 936+ 97BF ~            FAT32:
 937+ 97BF ~            DIR_FstClusHI
 938+ 97BF ~            DIR_FstClusLO
 939+ 97BF ~
 940+ 97BF ~            Vznikne:
 941+ 97BF ~            FirstCluster
 942+ 97BF ~
 943+ 97BF ~
 944+ 97BF ~            6. Převod clusteru na LBA
 945+ 97BF ~            -------------------------
 946+ 97BF ~            Platí pro FAT16 i FAT32 stejně:
 947+ 97BF ~
 948+ 97BF ~            FirstFileLBA =
 949+ 97BF ~            FirstDataSectorAbs +
 950+ 97BF ~            (FirstCluster − 2) × SecPerClus
 951+ 97BF ~
 952+ 97BF ~            Hotovo.
 953+ 97BF ~
 954+ 97BF ~
 955+ 97BF ~            Celý algoritmus
 956+ 97BF ~            ---------------
 957+ 97BF ~            MBR
 958+ 97BF ~             │
 959+ 97BF ~             ├── PartitionStartLBA
 960+ 97BF ~             │
 961+ 97BF ~             ▼
 962+ 97BF ~            Boot Sector
 963+ 97BF ~             │
 964+ 97BF ~             ├── SecPerClus
 965+ 97BF ~             ├── Reserved
 966+ 97BF ~             ├── FATSize
 967+ 97BF ~             ├── RootEntries (FAT16)
 968+ 97BF ~             └── RootCluster (FAT32)
 969+ 97BF ~             │
 970+ 97BF ~             ▼
 971+ 97BF ~            FirstDataSectorAbs
 972+ 97BF ~             │
 973+ 97BF ~             ▼
 974+ 97BF ~            Root Directory
 975+ 97BF ~             │
 976+ 97BF ~             ▼
 977+ 97BF ~            Najdi MBD / MBH
 978+ 97BF ~             │
 979+ 97BF ~             ▼
 980+ 97BF ~            FirstCluster
 981+ 97BF ~             │
 982+ 97BF ~             ▼
 983+ 97BF ~            FirstFileLBA
 984+ 97BF ~            */
