 546  8200              ; Vystup z EasyCF
 547  8200              ; ELEMENT: korektni start BSDOSu pres systemovou sluzbu #30.
 548  8200              ;          Pokud AUTOSYS neni nalezen / vrati se, provedeme
 549  8200              ;          velky 128K reset pres BSROM (BusySoft).
 550  8200              ; MB03+:   puvodni zpusob ukonceni zustava beze zmeny.
 551  8200              ;
 552  8200              ; Pri buildu pro eLeMeNt definuj symbol ELEMENT.
 553  8200              	IFDEF ELEMENT
 554  8200 ~            		ld	a,97		; BSDOS banka 1, zapis povolen
 555  8200 ~            		out	(23),a
 556  8200 ~            		ld	a,1		; aktualni BSDOS disk @1
 557  8200 ~            		ld	(#03EE),a
 558  8200 ~            		ld	a,#30		; BSDOS service #30 START
 559  8200 ~            		rst	#20		; pokud se AUTOSYS nenajde, sluzba se vrati
 560  8200 ~            		call	GUI.AUTOSYS_NOT_FOUND
 561  8200 ~            		call	#3C98		; prepne na BSROM + zakaz zapisu
 562  8200 ~            		xor	a
 563  8200 ~            		jp	#3978		; velky 128K reset (BSROM 1.18/1.40)
 564  8200              	ELSE
 565  8200 3E 40        		ld	a,%01000000
 566  8202 D3 17        		out	(23),a
 567  8204 FB           		ei
 568  8205 C9           		ret
 569  8206              	ENDIF
