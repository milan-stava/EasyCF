  91  8006              	IFDEF ELEMENT
  92  8006 ~            ;------------------------------------------------------------
  93  8006 ~            ; eLeMeNt ZX + external MB03+: route ZXi accesses to the external
  94  8006 ~            ; MB03+ and switch that interface to MB02+/BSDOS mode.
  95  8006 ~            ;
  96  8006 ~            ; First verify that this really is an eLeMeNt family machine.
  97  8006 ~            ; e_zxi_0FF: upper nibble #E identifies the eLeMeNt family.
  98  8006 ~            ; Lower nibble may change on future eLeMeNt revisions.
  99  8006 ~            ;
 100  8006 ~            ; g_zxi_000 = #00  -> external device (MB03+)
 101  8006 ~            ; m_zxi_000 = #01  -> MB02+ / BSDOS mode
 102  8006 ~            ;
 103  8006 ~            ; m_zxi_002 = #03 -> Hood/EasyCF IDE mapping, verified on real MB03+ hardware.
 104  8006 ~            EL_MB02_INIT
 105  8006 ~            		push	af
 106  8006 ~            		push	bc
 107  8006 ~
 108  8006 ~            		ld	bc,#783B
 109  8006 ~            		ld	a,#FF
 110  8006 ~            		out	(c),a
 111  8006 ~            		ld	bc,#793B
 112  8006 ~            		in	a,(c)
 113  8006 ~            		and	#F0
 114  8006 ~            		cp	#E0
 115  8006 ~            		jr	nz,.done
 116  8006 ~
 117  8006 ~            		; Select external MB03+ in the general ZXi device selector.
 118  8006 ~            		ld	bc,#7C3B
 119  8006 ~            		xor	a
 120  8006 ~            		out	(c),a
 121  8006 ~            		ld	bc,#7D3B
 122  8006 ~            		out	(c),a
 123  8006 ~
 124  8006 ~            		; Switch the external MB03+ to MB02+/BSDOS mode.
 125  8006 ~            		ld	bc,#703B
 126  8006 ~            		xor	a
 127  8006 ~            		out	(c),a
 128  8006 ~            		ld	bc,#713B
 129  8006 ~            		ld	a,#01
 130  8006 ~            		out	(c),a
 131  8006 ~
 132  8006 ~            		; Enable the Hood/EasyCF IDE mapping required by the ATA routines.
 133  8006 ~            		; Value #03 was verified on real MB03+ hardware with working BSDOS+CF.
 134  8006 ~            		ld	bc,#703B
 135  8006 ~            		ld	a,#02
 136  8006 ~            		out	(c),a
 137  8006 ~            		ld	bc,#713B
 138  8006 ~            		ld	a,#03
 139  8006 ~            		out	(c),a
 140  8006 ~
 141  8006 ~            .done		pop	bc
 142  8006 ~            		pop	af
 143  8006 ~            		ret
 144  8006 ~
 145  8006              	ENDIF
