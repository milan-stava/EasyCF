 939+ 99B0 ~
 940+ 99B0 ~            Vznikne:
 941+ 99B0 ~            FirstCluster
 942+ 99B0 ~
 943+ 99B0 ~
 944+ 99B0 ~            6. Převod clusteru na LBA
 945+ 99B0 ~            -------------------------
 946+ 99B0 ~            Platí pro FAT16 i FAT32 stejně:
 947+ 99B0 ~
 948+ 99B0 ~            FirstFileLBA =
 949+ 99B0 ~            FirstDataSectorAbs +
 950+ 99B0 ~            (FirstCluster − 2) × SecPerClus
 951+ 99B0 ~
 952+ 99B0 ~            Hotovo.
 953+ 99B0 ~
 954+ 99B0 ~
 955+ 99B0 ~            Celý algoritmus
 956+ 99B0 ~            ---------------
 957+ 99B0 ~            MBR
 958+ 99B0 ~             │
 959+ 99B0 ~             ├── PartitionStartLBA
 960+ 99B0 ~             │
 961+ 99B0 ~             ▼
 962+ 99B0 ~            Boot Sector
 963+ 99B0 ~             │
 964+ 99B0 ~             ├── SecPerClus
 965+ 99B0 ~             ├── Reserved
 966+ 99B0 ~             ├── FATSize
 967+ 99B0 ~             ├── RootEntries (FAT16)
 968+ 99B0 ~             └── RootCluster (FAT32)
 969+ 99B0 ~             │
 970+ 99B0 ~             ▼
 971+ 99B0 ~            FirstDataSectorAbs
 972+ 99B0 ~             │
 973+ 99B0 ~             ▼
 974+ 99B0 ~            Root Directory
 975+ 99B0 ~             │
 976+ 99B0 ~             ▼
 977+ 99B0 ~            Najdi MBD / MBH
 978+ 99B0 ~             │
 979+ 99B0 ~             ▼
 980+ 99B0 ~            FirstCluster
 981+ 99B0 ~             │
 982+ 99B0 ~             ▼
 983+ 99B0 ~            FirstFileLBA
 984+ 99B0 ~            */
