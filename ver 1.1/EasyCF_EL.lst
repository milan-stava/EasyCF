 852+ 99B0 ~            ---------------------------------------------------------------------------------------
 853+ 99B0 ~            BPB_BytesPerSec		offset	11	delka 2
 854+ 99B0 ~            BPB_SecPerClus		offset	13	delka 1
 855+ 99B0 ~            BPB_RsvdSecCnt		offset	14	delka 2
 856+ 99B0 ~            BPB_NumFATs		offset  16	delka 1
 857+ 99B0 ~
 858+ 99B0 ~            FAT16:
 859+ 99B0 ~                BPB_RootEntCnt	offset	17	delka 2
 860+ 99B0 ~                BPB_FATSz16		offset	22	delka 2
 861+ 99B0 ~
 862+ 99B0 ~            FAT32:
 863+ 99B0 ~                BPB_FATSz32		offset	36	delka 4
 864+ 99B0 ~                BPB_RootClus	offset	44	delka 4
 865+ 99B0 ~
 866+ 99B0 ~
 867+ 99B0 ~            3. vypocet prvniho datoveho sektoru
 868+ 99B0 ~            --------------------------------
 869+ 99B0 ~            FAT16
 870+ 99B0 ~            Spočti velikost Root Directory:
 871+ 99B0 ~
 872+ 99B0 ~            RootDirSectors =
 873+ 99B0 ~            (RootEntCnt × 32) / BytesPerSector
 874+ 99B0 ~
 875+ 99B0 ~            Potom:
 876+ 99B0 ~            FirstDataSectorRel =
 877+ 99B0 ~            RsvdSecCnt +
 878+ 99B0 ~            NumFATs × FATSz16 +
 879+ 99B0 ~            RootDirSectors
 880+ 99B0 ~
 881+ 99B0 ~            Absolutni LBA:
 882+ 99B0 ~            FirstDataSectorAbs =
 883+ 99B0 ~            PartitionStartLBA +
 884+ 99B0 ~            FirstDataSectorRel
 885+ 99B0 ~
 886+ 99B0 ~
 887+ 99B0 ~            FAT32
 888+ 99B0 ~            Root Directory je součást datové oblasti.
 889+ 99B0 ~
 890+ 99B0 ~            Proto:
 891+ 99B0 ~            FirstDataSectorRel =
 892+ 99B0 ~            RsvdSecCnt +
 893+ 99B0 ~            NumFATs × FATSz32
 894+ 99B0 ~
 895+ 99B0 ~            Absolutně:
 896+ 99B0 ~            FirstDataSectorAbs =
 897+ 99B0 ~            PartitionStartLBA +
 898+ 99B0 ~            FirstDataSectorRel
 899+ 99B0 ~
 900+ 99B0 ~
 901+ 99B0 ~            4. Načti Root Directory
 902+ 99B0 ~            -----------------------
 903+ 99B0 ~            FAT16
 904+ 99B0 ~
 905+ 99B0 ~            Root Directory začíná na:
 906+ 99B0 ~            RootDirLBA =
 907+ 99B0 ~            PartitionStartLBA +
 908+ 99B0 ~            RsvdSecCnt +
 909+ 99B0 ~            NumFATs × FATSz16
 910+ 99B0 ~
 911+ 99B0 ~            Je pevně daný.
 912+ 99B0 ~
 913+ 99B0 ~            FAT32
 914+ 99B0 ~
 915+ 99B0 ~            Root Directory začíná v clusteru:
 916+ 99B0 ~            RootCluster = BPB_RootClus
 917+ 99B0 ~
 918+ 99B0 ~            (obvykle 2)
 919+ 99B0 ~
 920+ 99B0 ~            První sektor Root Directory:
 921+ 99B0 ~            RootDirLBA =
 922+ 99B0 ~            FirstDataSectorAbs +
 923+ 99B0 ~            (RootCluster − 2) × SecPerClus
 924+ 99B0 ~
 925+ 99B0 ~
 926+ 99B0 ~
 927+ 99B0 ~            5. Najdi soubor MBD / MBH
 928+ 99B0 ~            -------------------------
 929+ 99B0 ~            Projdi prvních 8 položek.
 930+ 99B0 ~
 931+ 99B0 ~            Přečti:
 932+ 99B0 ~
 933+ 99B0 ~            FAT16:
 934+ 99B0 ~            DIR_FstClusLO
 935+ 99B0 ~
 936+ 99B0 ~            FAT32:
 937+ 99B0 ~            DIR_FstClusHI
