   7+ 0000              ;
   8+ 0000              ;   MUL32x8:
   9+ 0000              ;           MATH_MUL32x8
  10+ 0000              ;
  11+ 0000              ; Lokalni navesti zacinajici teckou jsou pro kazdou expanzi makra samostatna.
  12+ 0000              ;==============================================================================
  13+ 0000              ;seznam rutin:
  14+ 0000              ;1) MUL32x8	nasobeni DEHL x A ->DEHL
  15+ 0000              ;2) ADD32_16	přičtení 16 bitoveho cisla, DEHL=DEHL+BC
  16+ 0000              ;3) SUB32_8	odečtení 8 bitoveho cisla, DEHL=DEHL-A
  17+ 0000              ;4) ADD32_32	sečtení dvou 32 bitových čísel, DEHL=první číslo, DE'HL'=druhé číslo
  18+ 0000              ;*************************************************************************************
  19+ 0000                      MACRO MATH_MUL32x8
