  99  800E              ; eLeMeNt ZX + external MB03+: route ZXi accesses to the external
 100  800E              ; MB03+ and switch that interface to MB02+/BSDOS mode.
 101  800E              ;
 102  800E              ; First verify that this really is an eLeMeNt family machine.
 103  800E              ; e_zxi_0FF: upper nibble #E identifies the eLeMeNt family.
 104  800E              ; Lower nibble may change on future eLeMeNt revisions.
 105  800E              ;
 106  800E              ; g_zxi_000 = #00  -> external device (MB03+)
 107  800E              ; m_zxi_000 = #01  -> MB02+ / BSDOS mode
 108  800E              ;
 109  800E              ; m_zxi_002 = #03 -> Hood/EasyCF IDE mapping, verified on real MB03+ hardware.
 110  800E              EL_MB02_INIT
 111  800E F5           		push	af
 112  800F C5           		push	bc
