 779  8381 32 33 00     		ld	(#0033),a		; PAGE_SD = zatim neni nainstalovana
 780  8384 32 34 00     		ld	(#0034),a		; SD1 partition = none
 781  8387 32 35 00     		ld	(#0035),a		; SD2 partition = none
