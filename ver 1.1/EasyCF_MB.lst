  32+ 0000 ~                    add     hl,hl
  33+ 0000 ~                    rl      e
  34+ 0000 ~                    rl      d
  35+ 0000 ~
  36+ 0000 ~                    sla     b
  37+ 0000 ~                    jr      nc,.next
  38+ 0000 ~
  39+ 0000 ~                    ld      a,(.value)
  40+ 0000 ~                    add     a,l
  41+ 0000 ~                    ld      l,a
  42+ 0000 ~
  43+ 0000 ~                    ld      a,(.value+1)
  44+ 0000 ~                    adc     a,h
  45+ 0000 ~                    ld      h,a
  46+ 0000 ~
  47+ 0000 ~                    ld      a,(.value+2)
  48+ 0000 ~                    adc     a,e
  49+ 0000 ~                    ld      e,a
  50+ 0000 ~
  51+ 0000 ~                    ld      a,(.value+3)
  52+ 0000 ~                    adc     a,d
  53+ 0000 ~                    ld      d,a
  54+ 0000 ~
  55+ 0000 ~            .next:
  56+ 0000 ~                    dec     ixl
  57+ 0000 ~                    jr      nz,.loop
  58+ 0000 ~
  59+ 0000 ~                    pop     ix
  60+ 0000 ~                    ret
  61+ 0000 ~
  62+ 0000 ~            .value:
