  98  800B ~            ;------------------------------------------------------------
  99  800B ~            ; eLeMeNt ZX + external MB03+: route ZXi accesses to the external
 100  800B ~            ; MB03+ and switch that interface to MB02+/BSDOS mode.
 101  800B ~            ;
 102  800B ~            ; First verify that this really is an eLeMeNt family machine.
 103  800B ~            ; e_zxi_0FF: upper nibble #E identifies the eLeMeNt family.
 104  800B ~            ; Lower nibble may change on future eLeMeNt revisions.
 105  800B ~            ;
 106  800B ~            ; g_zxi_000 = #00  -> external device (MB03+)
 107  800B ~            ; m_zxi_000 = #01  -> MB02+ / BSDOS mode
 108  800B ~            ;
 109  800B ~            ; m_zxi_002 = #03 -> Hood/EasyCF IDE mapping, verified on real MB03+ hardware.
 110  800B ~            EL_MB02_INIT
 111  800B ~            		push	af
 112  800B ~            		push	bc
 113  800B ~
 114  800B ~            		ld	bc,#783B
 115  800B ~            		ld	a,#FF
 116  800B ~            		out	(c),a
 117  800B ~            		ld	bc,#793B
 118  800B ~            		in	a,(c)
 119  800B ~            		and	#F0
 120  800B ~            		cp	#E0
 121  800B ~            		jr	nz,.done
 122  800B ~
 123  800B ~            		; Select external MB03+ in the general ZXi device selector.
 124  800B ~            		ld	bc,#7C3B
 125  800B ~            		xor	a
 126  800B ~            		out	(c),a
 127  800B ~            		ld	bc,#7D3B
 128  800B ~            		out	(c),a
 129  800B ~
 130  800B ~            		; Switch the external MB03+ to MB02+/BSDOS mode.
 131  800B ~            		ld	bc,#703B
 132  800B ~            		xor	a
 133  800B ~            		out	(c),a
 134  800B ~            		ld	bc,#713B
 135  800B ~            		ld	a,#01
 136  800B ~            		out	(c),a
 137  800B ~
 138  800B ~            		; Enable the Hood/EasyCF IDE mapping required by the ATA routines.
 139  800B ~            		; Value #03 was verified on real MB03+ hardware with working BSDOS+CF.
 140  800B ~            		ld	bc,#703B
 141  800B ~            		ld	a,#02
 142  800B ~            		out	(c),a
 143  800B ~            		ld	bc,#713B
 144  800B ~            		ld	a,#03
 145  800B ~            		out	(c),a
 146  800B ~
 147  800B ~            .done		pop	bc
 148  800B ~            		pop	af
 149  800B ~            		ret
 150  800B ~
 151  800B              	ENDIF
